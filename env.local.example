# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Required: OpenAI-compatible Chat Completions endpoint used by
# /api/session-summary to generate the end-of-session structured report.
# Not used by the live conversation itself (that uses Agora's managed LLM).
# Example (Groq, free tier): https://api.groq.com/openai/v1/chat/completions
NEXT_LLM_URL=

# Required: API key for the above.
NEXT_LLM_API_KEY=

# Optional: secret used to sign the session tickets that scope token renewal
# and agent start/stop to the session that created them (see
# lib/session-ticket.ts). Falls back to NEXT_AGORA_APP_CERTIFICATE if unset,
# which is fine for local dev — set a dedicated random value in any deployed
# environment so rotating one secret doesn't rotate the other.
SESSION_TICKET_SECRET=

# Optional: hard cap, in seconds, on how long a single agent session may run
# (both server-enforced via the agent's expiresIn and client-enforced via an
# auto-end countdown). Defaults to 600 (10 minutes). Keep this low on a
# public/demo deployment — every second is billed Agora usage.
NEXT_PUBLIC_MAX_SESSION_SECONDS=600

# Optional: Upstash Redis (REST API) — free tier at https://upstash.com.
# Backs request-rate limiting on /api/invite-agent, /api/session-summary, and
# /api/suggest-topic (see lib/rate-limit.ts). Without these set, rate
# limiting is a no-op — fine for local dev, set both on any public deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: hard ceiling on how many agent sessions this deployment will
# start per day, across all callers combined — the actual cap on worst-case
# daily Agora spend, independent of the per-IP limit above (which alone
# can't stop many different IPs from each starting a few sessions).
# Defaults to 20. Only enforced when Upstash is configured.
DAILY_AGENT_SESSION_BUDGET=20

# Optional: Supabase project (https://supabase.com, free tier). Backs
# session persistence for the /s/[id] shareable report permalink
# (see lib/db.ts and supabase/schema.sql for the table it expects).
# Without these set, sessions simply aren't persisted — the summary still
# shows normally, there's just no share link. Use the service_role key
# (Project Settings -> API), not the anon key: all access goes through
# server-side routes, never the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
